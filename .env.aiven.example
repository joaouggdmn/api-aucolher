DB_URL=jdbc:postgresql://pg-ac96582-jpuggdn-2f5b.i.aivencloud.com:20175/defaultdb?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=COLE_A_SENHA_DO_AIVEN_AQUI
# Login com o Google: o script só passa para a API o que está neste arquivo.
# Sem estas duas linhas, o Google responde "The OAuth client was not found"
GOOGLE_CLIENT_ID=COLE_O_CLIENT_ID_DO_GOOGLE_AQUI
GOOGLE_CLIENT_SECRET=COLE_O_CLIENT_SECRET_DO_GOOGLE_AQUI
# Recuperar senha: SMTP do Gmail (senha de app). Sem estas duas linhas, o link só aparece no log da API
MAIL_USERNAME=
MAIL_PASSWORD=
# Conta Mercado Pago de cada ONG (Suas integrações -> aplicação do AUcolher).
# Sem estas linhas a API sobe, mas conectar a conta responde 503
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Idêntica à cadastrada na aplicação, ex: https://api.exemplo.com/api/mercado-pago/oauth/callback
MP_REDIRECT_URI=
# openssl rand -base64 32
MP_TOKEN_ENCRYPTION_KEY=
# Assina o state do OAuth; sem ele, vale o JWT_SECRET
MP_STATE_SECRET=
# true com as credenciais de teste
MP_TEST_TOKEN=true
