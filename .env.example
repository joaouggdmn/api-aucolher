# Modelo do .env: copie para .env (o Git ignora) e preencha. A API lê o .env sozinha
# (spring.config.import no application.properties), pelo Run do IntelliJ ou por mvn spring-boot:run.
# Formato: NOME=valor, sem aspas e sem espaços em volta do =.
#
# Banco: não precisa de nada aqui. Sem DB_URL, a API usa o PostgreSQL local
# (jdbc:postgresql://localhost:5432/aucolher_db, usuário postgres, senha 1234).
# Para outro banco, descomente e ajuste:
# DB_URL=jdbc:postgresql://localhost:5432/aucolher_db
# DB_USERNAME=postgres
# DB_PASSWORD=1234

# Login com o Google. Sem estas duas linhas, o Google responde "The OAuth client was not found"
GOOGLE_CLIENT_ID=COLE_O_CLIENT_ID_DO_GOOGLE_AQUI
GOOGLE_CLIENT_SECRET=COLE_O_CLIENT_SECRET_DO_GOOGLE_AQUI
# Recuperar senha: SMTP do Gmail (senha de app). Sem estas duas linhas, o link só aparece no log da API
MAIL_USERNAME=
MAIL_PASSWORD=
# Conta Mercado Pago de cada ONG (Suas integrações -> aplicação do AUcolher).
# Sem estas linhas a API sobe, mas conectar a conta responde 503
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Idêntica à cadastrada na aplicação, ex: https://api.exemplo.com/api/mercado-pago/oauth/callback
MP_REDIRECT_URI=
# openssl rand -base64 32. É a chave que abre os tokens já salvos no banco: não troque depois de conectar contas
MP_TOKEN_ENCRYPTION_KEY=
# Assina o state do OAuth; sem ele, vale o JWT_SECRET
MP_STATE_SECRET=
# false: com true, o Mercado Pago entrega um token TEST-, que a criação do PIX recusa (401)
MP_TEST_TOKEN=false
# Painel do Mercado Pago -> Webhooks -> assinatura secreta. Sem ela, o webhook responde 503
MP_WEBHOOK_SECRET=
# true só com contas de teste (pagador "APRO"). Com uma conta real conectada, deixe false:
# com true, o PIX continua real e sai em nome de um pagador falso
MP_SANDBOX=false
# Para onde a API manda o navegador depois de conectar a conta (e o link de recuperar senha)
FRONTEND_URL=http://localhost:5173

# Assistente de suporte (Google Gemini). Chave criada no Google AI Studio (aistudio.google.com).
# Sem ela, a API sobe e o balão do assistente avisa que está indisponível (503).
# No plano gratuito, o Google pode usar as perguntas e respostas para melhorar os produtos.
GEMINI_API_KEY=
# Opcionais: modelo (padrão gemini-3.6-flash) e nível de raciocínio (padrão LOW)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=LOW

# Opcional: com um segredo fixo (mínimo 32 caracteres), o login sobrevive a um restart da API.
# Sem ele, a API gera uma chave nova a cada execução e todo mundo precisa entrar de novo.
# JWT_SECRET=
